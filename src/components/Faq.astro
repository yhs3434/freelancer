---
import { faq } from '../data/faq';
---

<dl class="faq">
  {
    faq.map((item) => (
      <div class="faq__item">
        <dt class="faq__q">{item.q}</dt>
        <dd class="faq__a">{item.a}</dd>
      </div>
    ))
  }
</dl>

<style>
  .faq__item + .faq__item {
    margin-top: var(--space-5);
  }

  .faq__q {
    font-weight: 600;
  }

  .faq__a {
    margin-top: var(--space-1);
  }
</style>
