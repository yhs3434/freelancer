---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { site } from '../data/site';
import PlatformCta from './PlatformCta.astro';

// The six store images of the payments app: one product in six brand colours. This is the
// first real work a visitor sees, so it sits next to the headline.
const brands = (await getEntry('work', 'payments'))?.data.brands ?? [];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__text">
      <h1 id="hero-title" class="hero__title">{site.headline}</h1>
      <p class="hero__intro">{site.intro}</p>
      <p class="hero__status">Based in {site.location} ({site.utcLabel}). {site.availability}.</p>
      <div class="hero__ctas">
        <PlatformCta platform="upwork" label="Hire me on Upwork" />
        <PlatformCta platform="fiverr" label="See my Fiverr gigs" variant="secondary" />
      </div>
    </div>
    {
      brands.length > 0 && (
        <figure class="hero__work">
          <ul class="hero__brands" role="list">
            {brands.map((brand) => (
              <li>
                <Image
                  src={brand.banner}
                  alt={`Google Play image for ${brand.name}`}
                  widths={[320, 640]}
                  sizes="(min-width: 60rem) 19vw, 46vw"
                  loading="eager"
                />
              </li>
            ))}
          </ul>
          <figcaption>
            One merchant app I built, as it ships under six brands. <a href="/work/payments">How it works</a>
          </figcaption>
        </figure>
      )
    }
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-6);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-7);
  }

  .hero__title {
    font-size: var(--step-4);
    letter-spacing: -0.025em;
    line-height: 1.05;
    max-width: 17ch;
  }

  .hero__intro {
    margin-top: var(--space-5);
    max-width: 56ch;
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .hero__status {
    margin-top: var(--space-4);
    color: var(--muted);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .hero__brands {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .hero__brands :global(img) {
    width: 100%;
    border: 1px solid var(--rule);
    border-radius: 4px;
  }

  .hero__work figcaption {
    margin-top: var(--space-3);
    font-size: var(--step--1);
    color: var(--muted);
  }

  @media (min-width: 60rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--space-7);
      align-items: center;
    }
  }
</style>
