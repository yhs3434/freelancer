---
import { site } from '../data/site';
import PlatformCta from './PlatformCta.astro';
---

<div class="closing">
  <p class="closing__body">{site.cta.body}</p>
  <div class="closing__ctas">
    <PlatformCta platform="upwork" label="Message me on Upwork" />
    <PlatformCta platform="fiverr" label="See my Fiverr gigs" variant="secondary" />
  </div>
  <p class="closing__note">{site.cta.note}</p>
</div>

<style>
  .closing__body {
    max-width: 52ch;
  }

  .closing__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .closing__note {
    margin-top: var(--space-4);
    max-width: 60ch;
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>
