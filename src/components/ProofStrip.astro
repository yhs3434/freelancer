---
import { site } from '../data/site';
---

<section class="proof" aria-label="In numbers">
  <div class="wrap">
  <ul class="proof__list" role="list">
    {
      site.proof.map((item) => (
        <li class="proof__item">
          <a href={item.href}>
            <span class="proof__value">{item.value}</span>
            <span class="proof__label">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
  </div>
</section>

<style>
  .proof {
    border-top: 1px solid var(--rule);
  }

  .proof__list {
    display: grid;
    gap: 0;
  }

  .proof__item + .proof__item {
    border-top: 1px solid var(--rule);
  }

  .proof__item a {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-5);
    text-decoration: none;
  }

  .proof__value {
    flex: none;
    min-width: 1.4ch;
    font-family: var(--font-mono);
    font-size: var(--step-3);
    font-weight: 500;
    line-height: 1;
    color: var(--accent);
  }

  .proof__label {
    color: var(--muted);
    font-size: var(--step--1);
    max-width: 26ch;
  }

  .proof__item a:hover .proof__label {
    color: var(--ink);
  }

  @media (min-width: 48rem) {
    .proof__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .proof__item + .proof__item {
      border-top: 0;
      border-left: 1px solid var(--rule);
      padding-left: var(--space-5);
    }

    .proof__item a {
      flex-direction: column;
      gap: var(--space-3);
      padding-block: var(--space-6);
    }
  }
</style>
