---
import { site } from '../data/site';
import Base from '../layouts/Base.astro';
---

<Base notFound title={`Page not found · ${site.name}`} description="This page does not exist. Go back to the home page to see my work, services and how to hire me on Upwork or Fiverr.">
  <div class="wrap notfound">
    <p class="label">404</p>
    <h1>This page doesn't exist.</h1>
    <p class="muted">The link may be old, or the address has a typo.</p>
    <p><a href="/">Go to the home page</a> or <a href="/#work">see my work</a>.</p>
  </div>
</Base>

<style>
  .notfound {
    padding-block: var(--space-9);
  }

  .notfound h1 {
    margin-top: var(--space-3);
    font-size: var(--step-3);
  }

  .notfound p + p {
    margin-top: var(--space-3);
  }
</style>
