---
interface Props {
  id: string;
  label: string;
}

const { id, label } = Astro.props;
---

<section class="section" id={id} aria-labelledby={`${id}-label`}>
  <div class="wrap section__grid">
    <h2 class="label section__label" id={`${id}-label`}>{label}</h2>
    <div class="section__body">
      <slot />
    </div>
  </div>
</section>

<style>
  .section {
    border-top: 1px solid var(--rule);
    padding-block: var(--space-7) var(--space-8);
  }

  .section__grid {
    display: grid;
    gap: var(--space-5);
  }

  .section__label {
    line-height: 1.6;
    letter-spacing: 0.08em;
  }

  @media (min-width: 60rem) {
    .section__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-6);
    }

    .section__label {
      grid-column: 1 / 4;
      position: sticky;
      top: 5.5rem;
      align-self: start;
    }

    .section__body {
      grid-column: 4 / 13;
    }
  }
</style>
