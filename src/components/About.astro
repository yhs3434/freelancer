---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait-placeholder.svg';
import { site } from '../data/site';
---

<div class="about">
  <figure class="about__portrait" data-todo="portrait">
    <Image src={portrait} alt={`Portrait of ${site.name} (placeholder until a photo is added)`} width={160} height={200} />
  </figure>
  <div class="about__text">
    {site.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <dl class="about__timeline">
      {
        site.about.timeline.map((item) => (
          <div class="about__row" data-todo={item.todo ? 'timeline' : undefined}>
            <dt>{item.when}</dt>
            <dd>{item.what}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</div>

<style>
  .about {
    display: grid;
    gap: var(--space-5);
  }

  .about__portrait {
    width: 8rem;
  }

  .about__portrait :global(img) {
    width: 100%;
    border-radius: var(--radius);
  }

  .about__text p + p {
    margin-top: 1em;
  }

  .about__timeline {
    margin-top: var(--space-5);
  }

  .about__row {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: var(--space-4);
  }

  .about__row + .about__row {
    margin-top: var(--space-2);
  }

  .about__row dt {
    color: var(--muted);
  }

  @media (min-width: 40rem) {
    .about {
      grid-template-columns: 8rem minmax(0, 1fr);
      column-gap: var(--space-6);
      align-items: start;
    }
  }
</style>
