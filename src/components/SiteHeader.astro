---
import { site } from '../data/site';
import PlatformCta from './PlatformCta.astro';

const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/#services', label: 'Services' },
  { href: '/#how', label: 'How I work' },
  { href: '/#faq', label: 'FAQ' },
];
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-header__name" href="/">
      {site.name}
    </a>
    <nav class="site-header__nav" aria-label="Main">
      <ul role="list">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <PlatformCta platform="upwork" label="Hire me" variant="compact" />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: saturate(1.2) blur(6px);
    border-bottom: 1px solid var(--rule);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: 4rem;
  }

  .site-header__name {
    font-weight: 600;
    text-decoration: none;
    margin-right: auto;
  }

  .site-header__nav ul {
    display: flex;
    gap: var(--space-5);
  }

  .site-header__nav a {
    font-size: var(--step--1);
    color: var(--muted);
    text-decoration: none;
  }

  .site-header__nav a:hover {
    color: var(--ink);
  }

  @media (max-width: 47.99rem) {
    .site-header__nav {
      display: none;
    }
  }
</style>
