---
import { isPlaceholder } from '../lib/placeholder';

interface Props {
  client: string;
  years: string;
  platforms: string[];
  role: string;
  links: { label: string; href: string }[];
}

const { client, years, platforms, role, links } = Astro.props;
---

<dl class="meta">
  <div>
    <dt class="label">Client</dt>
    <dd>{client}</dd>
  </div>
  <div data-todo={isPlaceholder(years) ? 'years' : undefined}>
    <dt class="label">Years</dt>
    <dd>{years}</dd>
  </div>
  <div>
    <dt class="label">Platforms</dt>
    <dd>{platforms.join(', ')}</dd>
  </div>
  <div>
    <dt class="label">My role</dt>
    <dd>{role}</dd>
  </div>
  <div>
    <dt class="label">Links</dt>
    <dd>
      <ul role="list">
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </dd>
  </div>
</dl>

<style>
  .meta {
    display: grid;
    gap: var(--space-4);
    font-size: var(--step--1);
  }

  .meta > div {
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
  }

  .meta dd {
    margin-top: var(--space-1);
  }

  .meta li + li {
    margin-top: var(--space-1);
  }

  @media (min-width: 40rem) and (max-width: 59.99rem) {
    .meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
