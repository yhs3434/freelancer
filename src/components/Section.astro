---
interface Props {
  id: string;
  title: string;
  /** Wide sections use the full page width and get more room above. Default sections keep one reading column. */
  wide?: boolean;
}

const { id, title, wide = false } = Astro.props;
---

<section class:list={['section', { 'section--wide': wide }]} id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <h2 class="section__title" id={`${id}-title`}>{title}</h2>
    <div class="section__body">
      <slot />
    </div>
  </div>
</section>

<style>
  .section {
    padding-top: var(--space-8);
  }

  .section--wide {
    padding-top: var(--space-9);
  }

  .section__title {
    font-size: var(--step-3);
    letter-spacing: -0.02em;
  }

  .section__body {
    margin-top: var(--space-5);
  }

  .section:not(.section--wide) .section__title,
  .section:not(.section--wide) .section__body {
    max-width: 44rem;
  }

  .section--wide .section__body {
    margin-top: var(--space-6);
  }
</style>
