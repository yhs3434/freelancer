---
import { services } from '../data/services';
---

<ul class="services" role="list">
  {
    services.map((service) => (
      <li class="service">
        <h3 class="service__title">{service.title}</h3>
        <p class="service__body">{service.body}</p>
        {service.evidence && (
          <p class="service__evidence">
            <a href={service.evidence.href}>{service.evidence.label}</a>
          </p>
        )}
      </li>
    ))
  }
</ul>

<style>
  .service + .service {
    margin-top: var(--space-7);
  }

  .service__title {
    font-size: var(--step-1);
  }

  .service__body {
    margin-top: var(--space-2);
  }

  .service__evidence {
    margin-top: var(--space-2);
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>
