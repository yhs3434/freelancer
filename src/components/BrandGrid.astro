---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Brand {
  name: string;
  nameKo: string;
  icon: ImageMetadata;
  banner: ImageMetadata;
  href: string;
}

interface Props {
  brands: Brand[];
}

const { brands } = Astro.props;
---

<ul class="brands" role="list">
  {
    brands.map((brand) => (
      <li class="brand">
        <Image
          class="brand__banner"
          src={brand.banner}
          alt={`Store image for ${brand.name}: the same home screen in the brand's own colors.`}
          widths={[360, 720]}
          sizes="(min-width: 60rem) 22vw, (min-width: 40rem) 45vw, 100vw"
        />
        <div class="brand__row">
          <Image class="brand__icon" src={brand.icon} alt={`${brand.name} app icon`} width={40} height={40} densities={[1, 2]} />
          <div>
            <p class="brand__name">
              {brand.name} <span class="brand__ko" lang="ko">{brand.nameKo}</span>
            </p>
            <a class="brand__link mono" href={brand.href}>
              Google Play<span class="visually-hidden">: {brand.name}</span> →
            </a>
          </div>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .brands {
    display: grid;
    gap: var(--space-6) var(--space-5);
  }

  .brand__banner {
    width: 100%;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .brand__row {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    margin-top: var(--space-3);
  }

  .brand__icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.6rem;
    border: 1px solid var(--rule);
    background: #fff;
  }

  .brand__name {
    font-weight: 600;
    line-height: 1.3;
  }

  .brand__ko {
    font-weight: 400;
    color: var(--muted);
  }

  .brand__link {
    color: var(--muted);
  }

  @media (min-width: 40rem) {
    .brands {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 60rem) {
    .brands {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
