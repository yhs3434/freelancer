---
import { getCollection } from 'astro:content';
import About from '../components/About.astro';
import Closing from '../components/Closing.astro';
import Faq from '../components/Faq.astro';
import Hero from '../components/Hero.astro';
import Process from '../components/Process.astro';
import Section from '../components/Section.astro';
import Services from '../components/Services.astro';
import WorkCard from '../components/WorkCard.astro';
import { site } from '../data/site';
import Base from '../layouts/Base.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title={`${site.name}, freelance product engineer: mobile apps and payments`}
  description="Freelance product engineer in Seoul. I build mobile apps that take payments and the servers behind them. I take new work through Upwork and Fiverr."
>
  <Hero />

  <Section id="work" title="Work I've shipped" wide>
    {work.map((entry) => <WorkCard entry={entry} />)}
    {
      site.moreWork.length > 0 && (
        <ul class="more-work" role="list">
          {site.moreWork.map((item) => (
            <li>
              <strong>{item.title}</strong> <span class="muted">{item.detail}</span>
            </li>
          ))}
        </ul>
      )
    }
  </Section>

  <Section id="services" title="What I can build for you">
    <Services />
  </Section>

  <Section id="how" title="How I work">
    <Process />
  </Section>

  <Section id="about" title="About me">
    <About />
  </Section>

  <Section id="faq" title="Questions">
    <Faq />
  </Section>

  <Section id="contact" title={site.cta.heading}>
    <Closing />
  </Section>
</Base>

<style>
  .more-work {
    margin-top: var(--space-7);
  }

  .more-work li + li {
    margin-top: var(--space-3);
  }
</style>
